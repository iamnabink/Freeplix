# Copy to .env and fill in. Passed to the build with:
#   flutter build web --dart-define-from-file=.env
#
# Get a TMDB key at https://www.themoviedb.org/settings/api — the v4 read
# token is preferred; the v3 key is used only if no token is present.
TMDB_API_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional. A JSON array of playback sources this build should offer.
# Freeplix ships with none: with this unset it plays TMDB trailers.
# Point it only at a library you are licensed to stream. Example:
# FREEPLIX_SOURCES=[{"id":"library","name":"My Library","movie":"https://example.com/embed/movie/{tmdbId}","tv":"https://example.com/embed/tv/{tmdbId}/{season}/{episode}"}]
FREEPLIX_SOURCES=
